generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SALES_USER
}

enum EnquiryStatus {
  NEW
  QUOTED
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum SalesOrderStatus {
  PENDING
  CONFIRMED
  DISPATCHED
  CANCELLED
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(SALES_USER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  enquiries  Enquiry[]
  quotations Quotation[]

  @@map("users")
}

model Customer {
  id            Int      @id @default(autoincrement())
  companyName   String   @map("company_name")
  contactPerson String   @map("contact_person")
  mobile        String
  email         String
  city          String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  enquiries   Enquiry[]
  quotations  Quotation[]
  salesOrders SalesOrder[]

  @@index([companyName])
  @@map("customers")
}

model Product {
  id          Int      @id @default(autoincrement())
  productCode String   @unique @map("product_code")
  productName String   @map("product_name")
  category    String
  unit        String
  basePrice   Decimal  @map("base_price") @db.Decimal(12, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  inventory       Inventory?
  enquiryItems    EnquiryItem[]
  quotationItems  QuotationItem[]
  salesOrderItems SalesOrderItem[]
  dispatchItems   DispatchItem[]

  @@index([category])
  @@map("products")
}

model Inventory {
  id          Int      @id @default(autoincrement())
  productId   Int      @unique @map("product_id")
  physicalQty Int      @default(0) @map("physical_quantity")
  reservedQty Int      @default(0) @map("reserved_quantity")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

model Enquiry {
  id            Int           @id @default(autoincrement())
  enquiryNumber String        @unique @map("enquiry_number")
  customerId    Int           @map("customer_id")
  createdById   Int           @map("created_by_id")
  enquiryDate   DateTime      @default(now()) @map("enquiry_date")
  requiredDate  DateTime      @map("required_date")
  notes         String?
  status        EnquiryStatus @default(NEW)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  customer  Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items     EnquiryItem[]
  quotation Quotation?

  @@index([customerId])
  @@index([createdById])
  @@index([status])
  @@map("enquiries")
}

model EnquiryItem {
  id        Int @id @default(autoincrement())
  enquiryId Int @map("enquiry_id")
  productId Int @map("product_id")
  quantity  Int

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([enquiryId, productId])
  @@map("enquiry_items")
}

model Quotation {
  id              Int             @id @default(autoincrement())
  quotationNumber String          @unique @map("quotation_number")
  enquiryId       Int             @unique @map("enquiry_id")
  customerId      Int             @map("customer_id")
  createdById     Int             @map("created_by_id")
  quotationDate   DateTime        @default(now()) @map("quotation_date")
  validUntil      DateTime        @map("valid_until")
  discountPercent Decimal         @default(0) @map("discount_percent") @db.Decimal(5, 2)
  gstPercent      Decimal         @default(18) @map("gst_percent") @db.Decimal(5, 2)
  subtotal        Decimal         @db.Decimal(12, 2)
  discountAmount  Decimal         @map("discount_amount") @db.Decimal(12, 2)
  taxableAmount   Decimal         @map("taxable_amount") @db.Decimal(12, 2)
  gstAmount       Decimal         @map("gst_amount") @db.Decimal(12, 2)
  grandTotal      Decimal         @map("grand_total") @db.Decimal(12, 2)
  status          QuotationStatus @default(DRAFT)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  enquiry    Enquiry         @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy  User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items      QuotationItem[]
  salesOrder SalesOrder?

  @@index([customerId])
  @@index([createdById])
  @@index([status])
  @@map("quotations")
}

model QuotationItem {
  id              Int     @id @default(autoincrement())
  quotationId     Int     @map("quotation_id")
  productId       Int     @map("product_id")
  quantity        Int
  unitPrice       Decimal @map("unit_price") @db.Decimal(12, 2)
  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)
  gstPercent      Decimal @default(18) @map("gst_percent") @db.Decimal(5, 2)
  lineAmount      Decimal @map("line_amount") @db.Decimal(12, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([quotationId, productId])
  @@map("quotation_items")
}

model SalesOrder {
  id           Int              @id @default(autoincrement())
  orderNumber  String           @unique @map("order_number")
  customerId   Int              @map("customer_id")
  quotationId  Int              @unique @map("quotation_id")
  orderDate    DateTime         @default(now()) @map("order_date")
  totalAmount  Decimal          @map("total_amount") @db.Decimal(12, 2)
  status       SalesOrderStatus @default(PENDING)
  confirmedAt  DateTime?        @map("confirmed_at")
  dispatchedAt DateTime?        @map("dispatched_at")
  cancelledAt  DateTime?        @map("cancelled_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  customer  Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotation Quotation        @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  items     SalesOrderItem[]
  dispatch  Dispatch?

  @@index([customerId])
  @@index([status])
  @@map("sales_orders")
}

model SalesOrderItem {
  id           Int     @id @default(autoincrement())
  salesOrderId Int     @map("sales_order_id")
  productId    Int     @map("product_id")
  quantity     Int
  unitPrice    Decimal @map("unit_price") @db.Decimal(12, 2)
  lineAmount   Decimal @map("line_amount") @db.Decimal(12, 2)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([salesOrderId, productId])
  @@map("sales_order_items")
}

model Dispatch {
  id             Int      @id @default(autoincrement())
  dispatchNumber String   @unique @map("dispatch_number")
  salesOrderId   Int      @unique @map("sales_order_id")
  dispatchDate   DateTime @default(now()) @map("dispatch_date")
  vehicleNumber  String   @map("vehicle_number")
  driverName     String   @map("driver_name")
  createdAt      DateTime @default(now()) @map("created_at")

  salesOrder SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  items      DispatchItem[]

  @@map("dispatches")
}

model DispatchItem {
  id         Int @id @default(autoincrement())
  dispatchId Int @map("dispatch_id")
  productId  Int @map("product_id")
  quantity   Int

  dispatch Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([dispatchId, productId])
  @@map("dispatch_items")
}
